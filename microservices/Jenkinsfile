        stage('Docker Build') {
            steps {
                sh '''
                    docker compose build
                '''
            }
        }

        stage('Deploy') {
            steps {
                 withEnv([
            'MYSQL_USER=appuser',
            'MYSQL_PASSWORD=AppPassword@123'
        ]) {
                    sh '''
                        docker compose up -d --remove-orphans
                    '''
                }
            }
        }

    }

    post {
        success {
            echo 'Microservices deployed successfully!'
        }

        failure {
            echo 'Deployment failed. Check Jenkins logs.'
        }
    }
}
