pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                dir('demo-for-aug2026') {
                    sh 'docker build -t demo-for-aug2026:latest .'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f demo-springboot || true

                    docker run -d \
                      --name demo-springboot \
                      --restart unless-stopped \
                      --add-host=host.docker.internal:host-gateway \
                      -p 8081:8080 \
                      demo-for-aug2026:latest
                '''
            }
        }
    }
}